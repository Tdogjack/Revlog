{
  "expo": {
    "name": "Revlog",
    "slug": "revlog",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "revlog",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "me.revlog.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "me.revlog.app",
      "adaptiveIcon": {
        "backgroundColor": "#1c1c1e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1c1c1e",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Revlog uses your photos so you can add them to your cars and service records.",
          "cameraPermission": "Revlog uses the camera so you can photograph your car, parts, and receipts.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "backgroundColor": "#1c1c1e",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "071a6955-6e2b-4aaf-b263-e32e1234321a"
      }
    },
    "owner": "tr3vor1"
  }
}
