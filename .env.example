# Copy this file to .env.local and fill in the values from your own projects.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase: Connect > ORMs (or Database settings)
# Pooled connection (port 6543), used by the app
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
# Direct/session connection (port 5432), used for migrations
DIRECT_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Protects the daily cron jobs and signs unsubscribe links. Any long random
# string; set the same value in Vercel's environment variables.
CRON_SECRET=generate-a-long-random-string

# Resend, for reminder and test emails. Leave unset to skip sending.
RESEND_API_KEY=re_xxx
EMAIL_FROM="Revlog <reminders@example.com>"

# Optional: the site's public URL for links in emails. Defaults to Vercel's
# production domain, or http://localhost:3000 in development.
SITE_URL=
