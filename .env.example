# Copy this file to .env.local and fill in the values from your Supabase project.

# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Connect > ORMs (or Database settings)
# Pooled connection (port 6543), used by the app
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
# Direct/session connection (port 5432), used for migrations
DIRECT_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Protects the daily price-check job. Any long random string; set the same
# value in Vercel's environment variables.
CRON_SECRET=generate-a-long-random-string
